{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Profileinator",
  "version": "0.1.5",
  "identifier": "dev.profileinator.desktop",
  "build": {
    "frontendDist": "../../ui/out"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/": "bin/",
      "../../ui/out/": "ui/"
    },
    "publisher": "Profileinator",
    "shortDescription": "One memory of you for every AI agent",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "startMenuFolder": "Profileinator",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJENDU1OTRFMzM2MTRDRTYKUldUbVRHRXpUbGxGTFcyN3pFMlNLSU9GT2lFMk5INVV4M3cvV0diS2lvY09kRXl1ME0wRE1tOGYK",
      "endpoints": [
        "https://github.com/EthanRodrigues001/profileinator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
