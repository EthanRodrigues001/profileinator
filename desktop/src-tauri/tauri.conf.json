{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Profileinator",
  "version": "0.1.1",
  "identifier": "dev.profileinator.app",
  "build": {
    "frontendDist": "../../ui/out"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/": "bin/",
      "../../ui/out/": "ui/"
    },
    "publisher": "Profileinator",
    "shortDescription": "One memory of you for every AI agent",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}